{
	"name": "kino",
	"private": true,
	"type": "module",
	"scripts": {
		"i18n:check": "node scripts/check-i18n-catalogs.mjs",
		"i18n:compile": "pnpm run i18n:check && paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy cookie preferredLanguage baseLocale --output-structure message-modules --emit-ts-declarations --silent",
		"dev": "pnpm run dev:anonymous",
		"dev:clean": "node scripts/dev-clean.mjs",
		"dev:stop": "node scripts/dev-stop.mjs",
		"dev:respread-ports": "node scripts/respread-convex-ports.mjs",
		"setup": "bash scripts/setup-workspace.sh",
		"init": "pnpm run setup && pnpm run dev",
		"dev:anonymous": "KINO_CONVEX_MODE=anonymous node scripts/dev-supervisor.mjs",
		"dev:share": "node scripts/dev-share.mjs",
		"dev:shared": "KINO_CONVEX_MODE=shared node scripts/dev-supervisor.mjs",
		"dev:vite": "VITE_PORTLESS_URL=${PORTLESS_URL:-} vite dev",
		"dev:convex": "convex dev",
		"convex:local:init": "node scripts/init-native-local.mjs",
		"build": "pnpm run format:src && vite build",
		"format:src": "node scripts/format-source.mjs",
		"build:cloudflare": "sh scripts/cloudflare-build.sh",
		"deploy": "sh scripts/cloudflare-deploy.sh",
		"deploy:preview": "sh scripts/cloudflare-preview-upload.sh",
		"preview:name": "sh scripts/preview-name.sh",
		"preview:cleanup": "node scripts/cleanup-stale-previews.mjs",
		"preview:cleanup:cloudflare": "node scripts/cleanup-cloudflare-preview.mjs",
		"preview:cleanup:stale-cloudflare": "node scripts/cleanup-stale-cloudflare-previews.mjs",
		"preview:cleanup:convex": "node scripts/cleanup-convex-preview.mjs",
		"preview:cleanup:stale-convex": "node scripts/cleanup-stale-convex-previews.mjs",
		"pwa:assets": "node scripts/generate-pwa-assets.mjs",
		"dev:chrome-cdp": "bash scripts/dev-chrome-cdp.sh",
		"cf-typegen": "wrangler types",
		"preview": "vite preview",
		"test": "vitest run",
		"lint": "eslint",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
		"auth:env:audit": "node scripts/auth-env-audit.mjs",
		"auth:native:verify-package": "node scripts/check-native-auth-package.mjs",
		"auth:native:check-upstream": "node scripts/check-convex-auth-upstream.mjs",
		"auth:native:smoke": "node scripts/native-auth-smoke.mjs",
		"auth:native:prepare-local": "node scripts/prepare-native-auth-local.mjs",
		"gateway:webhook:register": "node scripts/gateway-webhook-target.mjs register",
		"gateway:webhook:unregister": "node scripts/gateway-webhook-target.mjs unregister",
		"typecheck": "pnpm run i18n:compile && tsc --noEmit && pnpm run typecheck:convex",
		"codegen": "convex codegen",
		"verify:generated": "bash scripts/verify-generated.sh",
		"verify:pr": "pnpm run verify:generated && pnpm run auth:native:verify-package && pnpm run typecheck",
		"typecheck:convex": "pnpm run typecheck:convex:native",
		"typecheck:convex:native": "tsc --noEmit --project convex/native/tsconfig.json"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1092.0",
		"@aws-sdk/s3-request-presigner": "^3.1092.0",
		"@base-ui/react": "^1.4.1",
		"@bentonow/bento-node-sdk": "^2.0.0",
		"@blobatar/react": "^2.6.0",
		"@convex-dev/auth": "github:get-convex/convex-auth#1d105a04d124785441ce655cef33b54103c7bc2e&path:packages/core",
		"@convex-dev/r2": "^0.10.2",
		"@convex-dev/rate-limiter": "0.3.2",
		"@convex-dev/react-query": "0.1.0",
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/geist": "^5.2.8",
		"@fontsource-variable/geist-mono": "^5.2.8",
		"@fontsource-variable/inter": "^5.2.8",
		"@headless-tree/core": "^1.7.0",
		"@headless-tree/react": "^1.7.0",
		"@inlang/paraglide-js-react": "1.0.3",
		"@opentelemetry/api": "1.9.0",
		"@posthog/react": "^1.10.3",
		"@react-email/components": "^1.0.12",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@tanstack/query-core": "5.101.4",
		"@tanstack/react-form": "^1.33.5",
		"@tanstack/react-query": "5.101.4",
		"@tanstack/react-router": "^1.170.32",
		"@tanstack/react-router-devtools": "^1.167.1",
		"@tanstack/react-router-ssr-query": "^1.167.1",
		"@tanstack/react-start": "^1.168.49",
		"@tanstack/react-table": "^9.1.2",
		"@tanstack/router-plugin": "^1.168.35",
		"@tiptap/extension-code-block-lowlight": "^3.23.4",
		"@tiptap/extension-link": "^3.23.4",
		"@tiptap/extension-placeholder": "^3.23.4",
		"@tiptap/extension-underline": "^3.23.4",
		"@tiptap/react": "^3.23.4",
		"@tiptap/starter-kit": "^3.23.4",
		"blobatar": "^2.6.0",
		"class-variance-authority": "^0.7.1",
		"cmdk": "^1.1.1",
		"cnfast": "^0.0.8",
		"convex": "1.46.0",
		"culori": "^4.0.2",
		"highlight.js": "^11.11.1",
		"hono": "4.12.9",
		"jose": "6.2.12",
		"lowlight": "^3.3.0",
		"lucide-react": "^1.16.0",
		"posthog-js": "^1.393.5",
		"react": "^19.2.4",
		"react-day-picker": "^10.0.1",
		"react-dom": "^19.2.4",
		"react-markdown": "^10.1.0",
		"react-merge-refs": "^3.0.2",
		"remark-gfm": "^4.0.1",
		"shadcn": "^4.7.0",
		"sharp": "^0.34.5",
		"sonner": "^2.0.7",
		"superjson": "2.2.6",
		"tailwindcss": "^4.2.1",
		"tailwindcss-hocus": "^1.0.0",
		"tw-animate-css": "^1.4.0",
		"vite-tsconfig-paths": "^5.1.4",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.38.0",
		"@convex-dev/eslint-plugin": "4.0.0",
		"@edge-runtime/vm": "^5.0.0",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@inlang/paraglide-js": "2.24.1",
		"@posthog/cli": "^0.7.33",
		"@tanstack/devtools-vite": "^0.8.5",
		"@tanstack/eslint-config": "^0.4.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "latest",
		"@types/culori": "^4.0.1",
		"@types/node": "^22.19.15",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"convex-test": "^0.0.56",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"jsdom": "^27.4.0",
		"portless": "^0.13.1",
		"prettier": "^3.8.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.64.0",
		"vite": "^7.3.1",
		"vitest": "^3.2.4",
		"web-vitals": "^5.1.0",
		"wrangler": "^4.136.3"
	},
	"packageManager": "pnpm@10.28.2"
}
